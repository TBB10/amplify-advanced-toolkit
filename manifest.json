{
  "manifest_version": 3,
  "name": "Amplify Advanced Toolkit",
  "version": "1.0.0",
  "description": "For Streamline staff: toggle shared site-wide HTML/CSS snippets on Amplify sites with live preview. Snippets sync from a shared GitHub library.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Amplify Advanced Toolkit",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["scripting", "activeTab", "tabs", "storage"],
  "host_permissions": [
    "https://*.specialdistrict.org/*",
    "https://api.github.com/*"
  ]
}
